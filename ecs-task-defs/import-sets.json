{
    "family": "collectables-import-sets-task",
    "taskRoleArn": "arn:aws:iam::654654440171:role/ecsTaskExecutionRole",
    "executionRoleArn": "arn:aws:iam::654654440171:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "sets-importer",
            "image": "654654440171.dkr.ecr.us-east-2.amazonaws.com/collectables/importer",
            "cpu": 0,
            "portMappings": [
                {
                    "name": "sets-importer-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "command": [
                "src/import_sets.py"
            ],
            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "/scripts"
                }
            ],
            "secrets": [
                {
                    "name": "APP_LIQUIBASE_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:654654440171:secret:staging/collectables/db-credentials-liquibase-2qpOSI:password::"
                },
                {
                    "name": "APP_LIQUIBASE_USER",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:654654440171:secret:staging/collectables/db-credentials-liquibase-2qpOSI:username::"
                },
                {
                    "name": "DB_URL",
                    "valueFrom": "arn:aws:secretsmanager:us-east-2:654654440171:secret:staging/collectables/db-credentials-KTdoSV:host::"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/collectables-import-sets-task",
                    "mode": "non-blocking",
                    "awslogs-create-group": "true",
                    "max-buffer-size": "25m",
                    "awslogs-region": "us-east-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
